# docker-compose.yml için — bu dosyayı .env olarak kopyalayıp doldurun.
# Not: buradaki host portları, Faz 0-11'de yerelde elle kurulan dev servisleriyle
# çakışmaması için kasıtlı olarak farklı (5433, 6391, 7475/7688, 19531, 8001, 8081).

POSTGRES_DB=satgit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5433

NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=satgit
NEO4J_HTTP_PORT=7475
NEO4J_BOLT_PORT=7688

MILVUS_DATABASE=satgit
MILVUS_PORT=19531

REDIS_PORT=6391

SECRET_KEY=generate-a-fernet-key
JWT_SECRET_KEY=change-me

SENTRY_DSN=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=
OLLAMA_BASE_URL=

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=

BACKEND_PORT=8001
FRONTEND_PORT=8081
VITE_API_BASE_URL=http://localhost:8001
